# Copie ce fichier en .env.oracle sur la VM Oracle. Ne jamais le commiter.
DOMAIN=dashboard.example.com
APP_NAME=mission-control
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
TIMEZONE=America/Montreal
LOCALE=fr-CA
GARDEROBE_INVENTAIRE_DIR=/data/imports/Garderobe

# Caddy sert le dashboard sur la même origine ; aucune URL locale ici.
CORS_ORIGINS=https://dashboard.example.com
CORS_ORIGIN_REGEX=

# Les secrets nécessaires uniquement à tes intégrations actives.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
TRADING212_KEY_ID=
TRADING212_SECRET=
TRADING212_BASE_URL=https://live.trading212.com
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_BASE_URL=https://api.kraken.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MUSIQUE_DEEPSEEK_MODEL=deepseek-chat

# Limites explicites pour la VM 2 OCPU / 12 Go.
BUFFETT_MAX_TRANSIENT_RETRY_PASSES=3
ETF_RESEARCH_SECONDS=180
ETF_RESEARCH_REQUESTS=80
ETF_RESEARCH_FUNDS=24
ETF_RESEARCH_INDICES=12
ETF_COMPOSITION_MAX_ROUNDS=3
